rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    match /cities/{cityId} {
      allow read, write: if isValidId(cityId);
    }

    match /fares/{fareId} {
      allow read, write: if isValidId(fareId);
    }

    match /vehicles/{vehicleId} {
      allow read, write: if isValidId(vehicleId);
    }

    match /bookings/{bookingId} {
      allow read, write: if isValidId(bookingId);
    }

    match /shipments/{shipmentId} {
      allow read, write: if isValidId(shipmentId);
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    match /settings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
